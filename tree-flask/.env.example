# ── Flask (DEV) ──────────────────────────────────────────────────────────────
# Copier en .env (même dossier, ignoré par git) et adapter.
# Chargé au démarrage par app.py (python-dotenv).
# En prod, ces valeurs viennent de deploy/env/flask.env (deploy/gen-env.sh).

DATABASE_URL=postgresql://admin:admin@localhost:5432/UTexchangedb
SPRING_URL=http://localhost:8070

# Même valeur que JWT_SECRET dans backend-spring/backend/.env (32 caractères minimum)
JWT_SECRET=dev-only-secret-change-me-in-prod-0123456789
JWT_TTL_SECONDS=28800

# false en dev (http://localhost) — true en prod (HTTPS obligatoire)
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
